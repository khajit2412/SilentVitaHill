diff --git a/pc_port/CMakeLists.txt b/pc_port/CMakeLists.txt
index f4eae20..e8e71ae 100644
--- a/pc_port/CMakeLists.txt
+++ b/pc_port/CMakeLists.txt
@@ -1,6 +1,21 @@
 cmake_minimum_required(VERSION 3.16)
 project(SilentHillPC C CXX)
 
+# PS Vita (vitasdk). The toolchain file reports CMAKE_SYSTEM_NAME Generic and
+# defines no platform variable, so detect it from VITASDK and name it VITA for
+# the rest of the build, the same way ANDROID and IOS are used below.
+if(DEFINED VITASDK AND CMAKE_C_COMPILER MATCHES "arm-vita-eabi")
+    set(VITA ON)
+    include("${VITASDK}/share/vita.cmake" REQUIRED)
+    set(VITA_APP_NAME "Silent Hill")
+    set(VITA_TITLEID  "SHPC00001")
+    set(VITA_VERSION  "00.10")
+    # Route every SDL_GL_* call (PsyCross and game alike) to vitaGL.
+    add_compile_options("SHELL:-include ${CMAKE_CURRENT_SOURCE_DIR}/vita_port/vita_sdlgl_shim.h"
+                        -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard)
+    message(STATUS "Target: PS Vita (vitasdk ${VITASDK})")
+endif()
+
 # pc_port is not always the top-level project: the Android APK adds it with
 # add_subdirectory, so CMAKE_SOURCE_DIR points at android_port/app/jni there.
 # Subdirectories (maps/) need pc_port's own location, and CMAKE_CURRENT_*
@@ -30,7 +45,9 @@ add_compile_options(-fno-strict-aliasing -fwrapv)
 # shared objects that link the static psycross_static archive; linking a
 # static (non-PIC) archive into a shared object fails, so force PIC globally.
 # Harmless on Windows/MinGW (PE code is already position-independent).
+if(NOT VITA)
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+endif()
 
 # =============================================================================
 # Options
@@ -43,7 +60,7 @@ option(SH_ASAN "Enable AddressSanitizer for memory corruption detection" OFF)
 # shared objects on a search path, a writable CWD next to the binary). None of
 # those hold inside an APK, so they default off for Android and stay on
 # everywhere else. Explicit -D on the command line still wins.
-if(ANDROID OR IOS)
+if(ANDROID OR IOS OR VITA)
     set(SH_DESKTOP_FEATURE_DEFAULT OFF)
 else()
     set(SH_DESKTOP_FEATURE_DEFAULT ON)
@@ -210,7 +227,7 @@ endif()
 # entirely and the software stack (xa_player_software.c + PsyX_SPUSoftware,
 # both SDL-sinked) becomes the only audio path. SH_NO_OPENAL collapses
 # xa_player_dispatch.c onto it — see the comment there.
-if(ANDROID OR IOS)
+if(ANDROID OR IOS OR VITA)
     list(FILTER PC_PORT_SOURCES EXCLUDE REGEX "xa_player\\.c$")
 endif()
 
@@ -411,7 +428,8 @@ target_compile_definitions(SilentHillPC PRIVATE
     VER_${SH_VERSION}
     SH_PC_PORT
     SKIP_ASM
-    $<$<OR:$<BOOL:${ANDROID}>,$<BOOL:${IOS}>>:SH_NO_OPENAL>
+    $<$<OR:$<BOOL:${ANDROID}>,$<BOOL:${IOS}>,$<BOOL:${VITA}>>:SH_NO_OPENAL>
+    $<$<BOOL:${VITA}>:SH_VITA>
     # Saves every iOS-conditional TU repeating the TargetConditionals dance.
     $<$<BOOL:${IOS}>:SH_IOS>
 )
@@ -582,7 +600,7 @@ endif()
 # SH_FMV_MJPEG drives the libjpeg-backed AVI override decoder in fmv_player.cpp.
 # The disc's own STR/MDEC FMVs never touch it, so a platform without libjpeg
 # (Android) just loses the override and still plays every cutscene.
-if(ANDROID OR IOS)
+if(ANDROID OR IOS OR VITA)
     message(STATUS "libjpeg: skipped (mobile) — MJPG AVI overrides disabled, disc STR FMVs unaffected")
 elseif(JPEG_LIBRARY)
     target_link_libraries(SilentHillPC PRIVATE ${JPEG_LIBRARY})
@@ -706,6 +724,20 @@ endif()
 
 if(WIN32)
     target_link_libraries(SilentHillPC PRIVATE opengl32 winmm m)
+elseif(VITA)
+    # vitaGL + vitaShaRK (runtime GLSL compile via SceShaccCg), then the stubs
+    # SDL2's Vita backend needs. Order matters: static archives, stubs last.
+    target_sources(SilentHillPC PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/vita_port/vita_sdlgl_shim.c)
+    target_link_libraries(SilentHillPC PRIVATE
+        vitaGL vitashark SceShaccCgExt taihen_stub
+        SDL2
+        SceShaccCg_stub SceKernelDmacMgr_stub SceGxm_stub SceDisplay_stub
+        SceCtrl_stub SceTouch_stub SceHid_stub SceMotion_stub
+        SceAudio_stub SceAudioIn_stub SceSysmodule_stub SceCommonDialog_stub
+        SceAppMgr_stub SceAppUtil_stub SceIme_stub SceRtc_stub ScePower_stub
+        SceLibKernel_stub SceKernelThreadMgr_stub SceIofilemgr_stub
+        z m pthread)
 elseif(ANDROID)
     # CMake counts Android as UNIX, but there is no desktop libGL to find here:
     # PsyX_render.h selects RENDERER_OGLES/OGLES_VERSION 3 on __ANDROID__, so
@@ -866,6 +898,13 @@ option(SH_STATIC_MAPS "Link map overlays into the executable with per-map symbol
 if(IOS AND NOT SH_BUILD_MAP_DLLS)
     set(SH_STATIC_MAPS ON CACHE BOOL "" FORCE)
 endif()
+# Vita has no dlopen for loose ELF overlays either (only signed .suprx), so it
+# takes the iOS route. See the .bss note above: on Vita that memory is NOT
+# demand-zero, which is the main thing to measure on hardware.
+if(VITA)
+    set(SH_BUILD_MAP_DLLS OFF CACHE BOOL "" FORCE)
+    set(SH_STATIC_MAPS ON CACHE BOOL "" FORCE)
+endif()
 # Android has the same problem for a different reason: it will dlopen only from
 # the APK's own extracted lib dir, and the loader builds a relative maps/<name>.so
 # path that resolves nowhere inside an app sandbox. Without this the binary
@@ -1102,3 +1141,15 @@ if(BUILD_TESTING)
         "${PSYCROSS_DIR}/include/psx" "${PSYCROSS_DIR}/include")
     add_test(NAME pc_big_tmd_test COMMAND pc_big_tmd_test)
 endif()
+
+# =============================================================================
+# PS Vita packaging: ELF -> SELF -> VPK
+# =============================================================================
+if(VITA)
+    # Vita heap: newlib gets what vitaGL leaves (see vita_sdlgl_shim.c).
+    vita_create_self(eboot.bin SilentHillPC UNSAFE)
+    vita_create_vpk(SilentHillPC.vpk ${VITA_TITLEID} eboot.bin
+        VERSION ${VITA_VERSION}
+        NAME ${VITA_APP_NAME}
+    )
+endif()
