--- /dev/null
+++ b/pc_port/vita_port/HANDOFF.md
@@ -0,0 +1,48 @@
+# PS Vita port — handoff notes
+
+Base: `SlickAmogus/silent-hill-decomp`, branch `android-port` (Sep 22, 2026).
+Work branch: `vita-port`. PsyCross (submodule) changes are in `0001-psycross-vita.patch`.
+
+## Build
+```sh
+export VITASDK=/usr/local/vitasdk   # vitasdk snapshot 2026-09-14 used
+# packages: vitaGL vitashark SDL2 zlib libjpeg-turbo (vdpm or vitasdk/packages releases)
+cd pc_port
+cmake -S . -B build-vita -G Ninja \
+  -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_BUILD_TYPE=Release
+ninja -C build-vita            # -> eboot.bin, SilentHillPC.vpk
+```
+Host needs llvm-nm + llvm-objcopy (static map symbol prefixing), python3.
+
+## Done
+- CMake: VITA detected from VITASDK; treated like ANDROID/IOS (software SPU via SDL audio,
+  SH_NO_OPENAL, no RA/ffmpeg/libjpeg desktop features); SH_STATIC_MAPS forced (43 overlays);
+  no PIC; vitaGL/vitashark/Sce*_stub link list; SELF + VPK packaging. Title ID SHPC00001 (placeholder).
+- `vita_port/vita_sdlgl_shim.{h,c}`: force-included; routes all SDL_GL_* to vitaGL
+  (vitasdk SDL2 has no GL context support). SDL keeps input/audio/timers.
+- PsyCross: `__vita__` -> RENDERER_OGLES, OGLES_VERSION 2 (GLSL ES 1.00 via vitaShaRK);
+  VRAM texture uses GL_RG8 (renderable U8U8 on GXM) instead of ES2 LUMINANCE_ALPHA;
+  compat defines for desktop-only paths; EGL typedef clash with vitaGL.h guarded.
+- psycross_static: builds clean for arm-vita-eabi.
+- Game target: 216/679 objects compiled with 0 errors before sandbox time limit. NOT yet linked.
+
+## Next steps (in order)
+1. Finish `ninja -C build-vita`, fix compile/link errors (expect missing stubs, dlopen refs in
+   dll_loader.c / pc_plugins.c / map_overlay_loader.c -> compile out for VITA).
+2. File paths: point fs_pc / config / saves at `ux0:data/silenthill/` (disc image lives there).
+3. KNOWN GAP — blend mode 3 (B + F/4): GXM has no constant blend colour. Currently plain additive
+   (too bright). Fix: uniform scaling src colour by 0.25 in the fragment shader for
+   BM_ADD_QUATER_SOURCE, blend GL_ONE,GL_ONE. Same idea for BM_CONSTANT_ALPHA (feedback damp).
+4. MEMORY — biggest risk: static maps reserve ~198 MB .bss (demand-zero on iOS, NOT on Vita).
+   Measure `arm-vita-eabi-size` on the ELF. If too big: union the per-map .bss into one shared
+   region (only one map is live at a time), or load maps with so_util (Rinnegatamante).
+   Also tune vglInitExtended ram_threshold and `_newlib_heap_size_user`.
+5. Controls: Vita pad/touch mapping (SDL gamecontroller works on Vita; rear touch for L2/R2).
+6. On-device: shader compile errors from vitaShaRK (needs libshacccg.suprx on the console),
+   performance (try 444 MHz via PSVshell), audio latency.
+
+## Disabled on Vita (optional PC extras)
+MSAA, flashlight shadow maps, grey-frame PBO debug probe, depth-bits query.
+
+## Never commit
+Disc images, extracted game assets, saves.
diff --git a/pc_port/vita_port/vita_sdlgl_shim.c b/pc_port/vita_port/vita_sdlgl_shim.c
new file mode 100644
index 0000000..bacac58
--- /dev/null
+++ b/pc_port/vita_port/vita_sdlgl_shim.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* vita_sdlgl_shim.c - vitaGL implementations behind vita_sdlgl_shim.h. */
+#if defined(__vita__)
+#include "vita_sdlgl_shim.h"
+#include <string.h>
+
+static int s_vglReady = 0;
+
+SDL_GLContext VitaGL_CreateContext(SDL_Window* w)
+{
+    (void)w;
+    if (!s_vglReady)
+    {
+        /* ram_threshold: RAM vitaGL leaves free for the newlib heap.
+         * Tuned later against real memory pressure (map .bss, VRAM tex). */
+        vglInitExtended(0, VITA_SCREEN_W, VITA_SCREEN_H,
+                        16 * 1024 * 1024, SCE_GXM_MULTISAMPLE_NONE);
+        s_vglReady = 1;
+    }
+    return (SDL_GLContext)(uintptr_t)1; /* any non-NULL handle */
+}
+
+void VitaGL_SwapWindow(SDL_Window* w)
+{
+    (void)w;
+    vglSwapBuffers(GL_FALSE);
+}
+
+int VitaGL_SetSwapInterval(int interval)
+{
+    vglWaitVblankStart(interval ? GL_TRUE : GL_FALSE);
+    return 0;
+}
+
+void VitaGL_GetDrawableSize(SDL_Window* w, int* x, int* y)
+{
+    (void)w;
+    if (x) *x = VITA_SCREEN_W;
+    if (y) *y = VITA_SCREEN_H;
+}
+
+int VitaGL_GetAttribute(SDL_GLattr attr, int* value)
+{
+    if (!value) return -1;
+    switch (attr)
+    {
+    case SDL_GL_RED_SIZE: case SDL_GL_GREEN_SIZE:
+    case SDL_GL_BLUE_SIZE: case SDL_GL_ALPHA_SIZE: *value = 8; break;
+    case SDL_GL_DEPTH_SIZE:   *value = 32; break;
+    case SDL_GL_STENCIL_SIZE: *value = 8; break;
+    case SDL_GL_DOUBLEBUFFER: *value = 1; break;
+    case SDL_GL_CONTEXT_MAJOR_VERSION: *value = 2; break;
+    default: *value = 0; break;
+    }
+    return 0;
+}
+
+void* VitaGL_GetProcAddress(const char* name)
+{
+    return vglGetProcAddress(name);
+}
+#endif
diff --git a/pc_port/vita_port/vita_sdlgl_shim.h b/pc_port/vita_port/vita_sdlgl_shim.h
new file mode 100644
index 0000000..3a675f5
--- /dev/null
+++ b/pc_port/vita_port/vita_sdlgl_shim.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * vita_sdlgl_shim.h - force-included on PS Vita builds only (-include).
+ *
+ * vitasdk's SDL2 has no OpenGL context support: it renders through its own
+ * GXM backend. vitaGL owns GXM here instead, so SDL keeps input, audio,
+ * timers and threads, while every SDL_GL_* call PsyCross makes is routed to
+ * vitaGL. Keeping this in one header means the upstream renderer builds for
+ * Vita without per-call #ifdefs.
+ */
+#ifndef VITA_SDLGL_SHIM_H
+#define VITA_SDLGL_SHIM_H
+#if defined(__vita__)
+
+#ifdef __cplusplus
+#include <SDL2/SDL.h>
+#include <vitaGL.h>
+extern "C" {
+#else
+#include <SDL2/SDL.h>
+#include <vitaGL.h>
+#endif
+
+#define VITA_SCREEN_W 960
+#define VITA_SCREEN_H 544
+
+SDL_GLContext VitaGL_CreateContext(SDL_Window* w);
+void          VitaGL_SwapWindow(SDL_Window* w);
+int           VitaGL_SetSwapInterval(int interval);
+void          VitaGL_GetDrawableSize(SDL_Window* w, int* x, int* y);
+int           VitaGL_GetAttribute(SDL_GLattr attr, int* value);
+void*         VitaGL_GetProcAddress(const char* name);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* The Vita SDL video driver rejects SDL_WINDOW_OPENGL outright ("No OpenGL
+ * support in video driver"); a plain window is all vitaGL needs. */
+#define SDL_WINDOW_OPENGL              ((SDL_WindowFlags)0)
+
+#define SDL_GL_CreateContext(w)        VitaGL_CreateContext(w)
+#define SDL_GL_SwapWindow(w)           VitaGL_SwapWindow(w)
+#define SDL_GL_SetSwapInterval(i)      VitaGL_SetSwapInterval(i)
+#define SDL_GL_GetDrawableSize(w,x,y)  VitaGL_GetDrawableSize(w,x,y)
+#define SDL_GL_GetAttribute(a,v)       VitaGL_GetAttribute(a,v)
+#define SDL_GL_GetProcAddress(n)       VitaGL_GetProcAddress(n)
+/* Attributes are fixed by vglInit (MSAA mode, stencil); accept and ignore. */
+#define SDL_GL_SetAttribute(a,v)       ((void)(a),(void)(v),0)
+#define SDL_GL_ResetAttributes()       ((void)0)
+#define SDL_GL_DeleteContext(c)        ((void)(c))
+#define SDL_GL_MakeCurrent(w,c)        ((void)(w),(void)(c),0)
+
+#endif /* __vita__ */
+#endif /* VITA_SDLGL_SHIM_H */
-- 
